<?xml version="1.0"?>
<launch>
    <!-- 装配控制节点启动文件（Ch4） -->
    
    <arg name="robot_type" default="ur5"/>
    
    <!-- 启动UR机器人驱动（如果使用真机） -->
    <!-- <include file="$(find ur_robot_driver)/launch/ur5e_bringup.launch"/> -->
    
    <!-- 启动力传感器驱动 -->
    <!-- <node name="ft_sensor_driver" pkg="ati_ft_sensor" type="ft_sensor_node.py"/> -->
    
    <!-- 启动装配控制节点 -->
    <node name="control_node" pkg="chapter5_system_integration" 
          type="control_node.py" output="screen">
        <param name="sac_model_path"
               value="$(find chapter5_system_integration)/../../第4章内容与代码实现/chapter4_assembly_control/checkpoints/sac_final.pt"/>
        <param name="robot_type" value="$(arg robot_type)"/>
        <param name="control_frequency" value="500"/>
    </node>
    
</launch>

